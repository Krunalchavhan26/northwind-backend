<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
	version="3.0">

	<persistence-unit name="northwindPU"
		transaction-type="RESOURCE_LOCAL">

		<provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

		<class>com.northwind.entity.User</class>
		<class>com.northwind.entity.Product</class>
		<class>com.northwind.entity.Order</class>
		<class>com.northwind.entity.OrderItem</class>
		<class>com.northwind.entity.CheckoutSession</class>

		<exclude-unlisted-classes>true</exclude-unlisted-classes>

		<!-- No connection props here — JPAUtil passes them at runtime -->

	</persistence-unit>

</persistence>